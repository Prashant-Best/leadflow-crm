{
  "name": "leadflow-crm-server",
  "version": "1.0.0",
  "private": true,
  "description": "LeadFlow CRM REST API (Express + MongoDB)",
  "author": "Prashant Panwar",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "seed": "node scripts/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "mongodb-memory-server-core": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
